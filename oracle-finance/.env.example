APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8090
DATABASE_PATH=/app/data/finance.db
SYNC_API_TOKEN=replace-with-a-long-random-secret
SPLITWISE_ENABLED=false
SPLITWISE_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
GMAIL_ENABLED=false
GMAIL_PROVIDER=imap
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_IMAP_FOLDER=INBOX
GMAIL_CREDENTIALS=/app/secrets/credentials.json
GMAIL_TOKEN=/app/secrets/gmail-token.json
GMAIL_REDIRECT_URI=http://localhost:8090/api/v1/gmail/callback
FINANCE_SYNC_INTERVAL_SECONDS=1800
GMAIL_QUERY=newer_than:30d
HDFC_STATEMENT_SECRET=
HDFC_STATEMENT_SECRET_FILE=
ICICI_STATEMENT_SECRET=
ICICI_STATEMENT_SECRET_FILE=
AXIS_STATEMENT_SECRET=
AXIS_STATEMENT_SECRET_FILE=
SBI_STATEMENT_SECRET=
SBI_STATEMENT_SECRETS=
SBI_STATEMENT_SECRET_FILE=
INDUSIND_STATEMENT_SECRET=
INDUSIND_STATEMENT_SECRET_FILE=

# Separate least-privilege token for the read-only Google Sheets snapshot endpoint
SHEETS_SYNC_TOKEN=replace-with-a-different-long-random-secret

# Expense app (your personal two-person app on Supabase): the finance server adds expenses to it and lists
# the ones not added yet. The old SPLITS_* names still work.
# Use a dedicated Supabase user for the server and add its email to allowed_users. Never commit real values.
EXPENSE_SUPABASE_URL=
EXPENSE_SUPABASE_KEY=
EXPENSE_EMAIL=
EXPENSE_PASSWORD=
# Only rows on/after this date are compared (default 2026-11-25)
EXPENSE_TRACK_FROM=2026-11-25

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/textViewReviewTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Review &amp; Reconcile"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/buttonRefreshReviews"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/buttonRefreshReviews"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Refresh"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textViewReviewSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Resolve unmatched or ambiguous evidence and review financial SMS that could not be parsed."
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonRefreshReviews" />

    <TextView
        android:id="@+id/textViewEvidenceSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Evidence needing a transaction match"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewReviewSubtitle" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewReviews"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        app:layout_constraintBottom_toTopOf="@id/textViewUnrecognizedSection"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewEvidenceSection"
        app:layout_constraintVertical_bias="0.5" />

    <TextView
        android:id="@+id/textViewNoReviews"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No unmatched or ambiguous evidence."
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/recyclerViewReviews"
        app:layout_constraintEnd_toEndOf="@id/recyclerViewReviews"
        app:layout_constraintStart_toStartOf="@id/recyclerViewReviews"
        app:layout_constraintTop_toTopOf="@id/recyclerViewReviews" />

    <TextView
        android:id="@+id/textViewUnrecognizedSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Unrecognized financial SMS"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recyclerViewReviews" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewUnrecognized"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:nestedScrollingEnabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewUnrecognizedSection" />

    <TextView
        android:id="@+id/textViewNoUnrecognized"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No unrecognized financial SMS."
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/recyclerViewUnrecognized"
        app:layout_constraintEnd_toEndOf="@id/recyclerViewUnrecognized"
        app:layout_constraintStart_toStartOf="@id/recyclerViewUnrecognized"
        app:layout_constraintTop_toTopOf="@id/recyclerViewUnrecognized" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textViewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Finance"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Notification-trigger status: a small pill instead of a line of coloured text. -->
    <TextView
        android:id="@+id/textViewNotificationStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp"
        android:text="● Checking…"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/textViewTitle"
        app:layout_constraintEnd_toStartOf="@id/buttonThemeTop"
        android:layout_marginEnd="4dp"
        app:layout_constraintTop_toTopOf="@id/textViewTitle" />

    <!-- Only visible while a newer build is waiting on the server. -->
    <Button
        android:id="@+id/buttonUpdateTop"
        style="@style/Widget.Material3.Button"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginEnd="6dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:paddingHorizontal="14dp"
        android:text="Update"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/textViewTitle"
        app:layout_constraintEnd_toStartOf="@id/textViewNotificationStatus"
        app:layout_constraintTop_toTopOf="@id/textViewTitle" />

    <!-- Top right: theme picker, then settings (the most right one). -->
    <ImageButton
        android:id="@+id/buttonThemeTop"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Theme"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_palette"
        app:layout_constraintBottom_toBottomOf="@id/textViewTitle"
        app:layout_constraintEnd_toStartOf="@id/buttonSettingsTop"
        app:layout_constraintTop_toTopOf="@id/textViewTitle" />

    <ImageButton
        android:id="@+id/buttonSettingsTop"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Settings"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_settings"
        app:layout_constraintBottom_toBottomOf="@id/textViewTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/textViewTitle" />

    <Button
        android:id="@+id/buttonOpenNotificationSettings"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Enable Gmail Notifications"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewTitle" />

    <LinearLayout
        android:id="@+id/oracleLedgerPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="?attr/heroBackground"
        android:orientation="vertical"
        android:padding="?attr/heroPad"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonOpenNotificationSettings">

        <TextView
            android:id="@+id/textViewOracleStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Oracle ledger: Loading..."
            android:textColor="?attr/heroMuted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textViewTrueLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="True available"
            android:textColor="?attr/heroMuted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/textViewTrueAvailable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:text="—"
            android:textColor="?attr/heroText"
            android:textSize="40sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="?attr/heroRuleTop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
            android:layout_marginEnd="8dp"
                android:background="?attr/heroChip"
                android:orientation="vertical"
                android:padding="?attr/heroChipPad">

                <TextView
                    android:id="@+id/textViewStatBankLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bank cash"
                    android:textColor="?attr/heroMuted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/textViewBankCash"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:text="—"
                    android:textColor="?attr/heroText"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="17sp"
                    app:autoSizeMinTextSize="9sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
            android:layout_marginEnd="8dp"
                android:background="?attr/heroChip"
                android:orientation="vertical"
                android:padding="?attr/heroChipPad">

                <TextView
                    android:id="@+id/textViewStatSplitwiseLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Splitwise"
                    android:textColor="?attr/heroMuted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/textViewSplitwiseReceivable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:text="—"
                    android:textColor="?attr/heroAccent"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="17sp"
                    app:autoSizeMinTextSize="9sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/heroChip"
                android:orientation="vertical"
                android:padding="?attr/heroChipPad">

                <TextView
                    android:id="@+id/textViewStatCardsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cards"
                    android:textColor="?attr/heroMuted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/textViewCardOutstanding"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:text="—"
                    android:textColor="?attr/heroText"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="17sp"
                    app:autoSizeMinTextSize="9sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/heroRuleBottom" />

        <TextView
            android:id="@+id/textViewEmiNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="?attr/heroMuted"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/oracleControlsRow"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/oracleLedgerPanel">

        <Button
            android:id="@+id/buttonEditSplitwise"
            android:visibility="gone"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="0dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:paddingHorizontal="4dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"
            android:text="Splitwise"
            android:textSize="12sp"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_group"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconSize="22dp" />
        <Button
            android:id="@+id/buttonEditBankAccounts"
            android:visibility="gone"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:paddingHorizontal="4dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"
            android:text="Banks"
            android:textSize="12sp"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_bank"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconSize="22dp" />
        <Button
            android:id="@+id/buttonEditCreditCards"
            android:visibility="gone"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:paddingHorizontal="4dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"
            android:text="Cards"
            android:textSize="12sp"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_card"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconSize="22dp" />
        <Button
            android:id="@+id/buttonMore"
            android:visibility="gone"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:paddingHorizontal="4dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"
            android:text="More"
            android:textSize="12sp"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_more"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconSize="22dp" />

    </LinearLayout>

    <!-- The rest of the old buttons live in the More sheet; the views stay here so it can use them. -->
    <LinearLayout
        android:id="@+id/oracleControlsRow2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/oracleControlsRow">

        <Button
            android:id="@+id/buttonOracleSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings" />

        <Button
            android:id="@+id/buttonClearLocalHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear history" />

        <Button
            android:id="@+id/buttonRestoreHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Restore history" />

        <Button
            android:id="@+id/buttonGmailSync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sync Gmail" />

        <Button
            android:id="@+id/buttonReviewReconcile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Review" />

        <Button
            android:id="@+id/buttonSmsLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMS Log" />

    </LinearLayout>

    <!-- Credit-card limit / due-date tiles; filled in by code and hidden until a card has a limit or due day. -->
    <HorizontalScrollView
        android:id="@+id/cardsScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/oracleControlsRow">

        <LinearLayout
            android:id="@+id/cardsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardsScroll">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewTransactions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            tools:listitem="@layout/item_transaction" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <TextView
        android:id="@+id/textViewEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No transactions found."
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/swipeRefresh" />

    <LinearLayout
        android:id="@+id/selectionBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
                android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/selectionCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textStyle="bold" />

        <Button
            android:id="@+id/selectionAddToExpense"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Add to Expense" />

        <Button
            android:id="@+id/selectionCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Cancel" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
